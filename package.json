{
  "name": "@local/dsh-investment-kb",
  "version": "0.1.0",
  "private": true,
  "description": "Local, versioned investment research sources with verifiable citations for DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "kb_service.mjs", "bridge.mjs", "picker.mjs", "kb_cli.py", "kb_store.py", "kb_formats.py", "kb_folders.py", "kb_planet.py", "icon.svg", "locale/*.json", "cordis.patch.yml", "README.md"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale"]}
  }
}
